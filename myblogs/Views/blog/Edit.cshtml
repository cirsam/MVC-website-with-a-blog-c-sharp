@model myblogs.Models.BlogModelClass

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>BlogModelClass</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="BlogId" />
            <div class="form-group">
                <label asp-for="UserId" class="control-label"></label>
                <input asp-for="UserId" class="form-control" />
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BlogTitle" class="control-label"></label>
                <input asp-for="BlogTitle" class="form-control" />
                <span asp-validation-for="BlogTitle" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SelectedblogTypeId" class="control-label"></label>
                <input asp-for="SelectedblogTypeId" class="form-control" />
                <span asp-validation-for="SelectedblogTypeId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SelectedBlogPublishStatusOptionsId" class="control-label"></label>
                <input asp-for="SelectedBlogPublishStatusOptionsId" class="form-control" />
                <span asp-validation-for="SelectedBlogPublishStatusOptionsId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BlogText" class="control-label"></label>
                <textarea asp-for="BlogText" class="form-control"></textarea>
                <span asp-validation-for="BlogText" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Datecreated" class="control-label"></label>
                <input asp-for="Datecreated" class="form-control" />
                <span asp-validation-for="Datecreated" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
