@model IEnumerable<myblogs.Models.BlogTypesModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.UserId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BlogTypeName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BlogTypeDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateCreated)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.UserId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BlogTypeName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BlogTypeDescription)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateCreated)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.BlogTypeId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.BlogTypeId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.BlogTypeId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
